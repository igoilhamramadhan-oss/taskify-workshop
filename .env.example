# ============================================================
# KREDENSIAL SUPABASE - TASKIFY WORKSHOP APP
# ============================================================
# LANGKAH:
#   1. Salin file ini menjadi file baru bernama: .env
#      (bukan .env.example, tapi .env saja tanpa extension lain)
#   2. Ganti nilai placeholder di bawah dengan kredensial asli dari:
#      Supabase Dashboard > Project Settings > API
#
# PENTING:
#   - JANGAN pernah commit file .env ke Git (sudah ada di .gitignore)
#   - Gunakan ANON KEY (public), BUKAN service_role key!
#   - Setelah mengisi file .env, restart server: npm run dev
# ============================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
